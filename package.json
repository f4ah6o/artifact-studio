{
  "name": "artifact-studio",
  "version": "2026.8.0",
  "description": "AI-assisted artifact studio — generate, edit, validate, persist and export structured artifacts; BPMN is the first adapter",
  "keywords": [
    "bpmn",
    "bpmn2",
    "diagram",
    "elkjs",
    "layout",
    "modeler",
    "omg",
    "process",
    "svg",
    "workflow",
    "xml"
  ],
  "license": "MIT",
  "author": "f12o <gh@f12o.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f4ah6o/artifact-studio.git"
  },
  "type": "module",
  "main": "./src/bpmn/pipeline.js",
  "exports": {
    ".": "./src/bpmn/pipeline.js",
    "./import": "./src/bpmn/import.js",
    "./validate": "./src/bpmn/validate.js",
    "./orchestrator": "./src/ai/orchestrator.js"
  },
  "scripts": {
    "generate": "node src/bpmn/pipeline.js",
    "build:skill": "node tools/build-skill.mjs",
    "dev": "node tools/dev.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bpmn-js": "18.24.0",
    "bpmn-js-i18n": "2.4.0",
    "bpmn-moddle": "^10.0.0",
    "elkjs": "^0.11.1",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "bpmn-auto-layout": "^1.3.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<businessObjectModel xmlns="http://documentation.bonitasoft.com/bdm-xml-schema/1.0" modelVersion="1.0" productVersion="7.10.0">
    <businessObjects>
        <businessObject qualifiedName="com.example.sales.Customer">
            <description>Customer who places an order.</description>
            <fields>
                <field type="STRING" length="80" name="name" nullable="false" collection="false"/>
                <field type="STRING" length="255" name="email" nullable="false" collection="false"/>
            </fields>
            <uniqueConstraints>
                <uniqueConstraint name="UK_CUSTOMER_EMAIL">
                    <fieldNames>
                        <fieldName>email</fieldName>
                    </fieldNames>
                </uniqueConstraint>
            </uniqueConstraints>
            <queries/>
            <indexes>
                <index name="IDX_CUSTOMER_NAME">
                    <fieldNames>
                        <fieldName>name</fieldName>
                    </fieldNames>
                </index>
            </indexes>
        </businessObject>
        <businessObject qualifiedName="com.example.sales.Order">
            <description>Order placed by a customer. Order lines are owned by the order.</description>
            <fields>
                <field type="STRING" length="32" name="orderNumber" nullable="false" collection="false"/>
                <field type="LOCALDATE" name="orderedOn" nullable="false" collection="false"/>
                <field type="STRING" length="32" name="status" nullable="false" collection="false"/>
                <relationField type="AGGREGATION" reference="com.example.sales.Customer" fetchType="LAZY" name="customer" nullable="false" collection="false"/>
                <relationField type="COMPOSITION" reference="com.example.sales.OrderLine" fetchType="LAZY" name="lines" nullable="false" collection="true"/>
            </fields>
            <uniqueConstraints>
                <uniqueConstraint name="UK_ORDER_NUMBER">
                    <fieldNames>
                        <fieldName>orderNumber</fieldName>
                    </fieldNames>
                </uniqueConstraint>
            </uniqueConstraints>
            <queries>
                <query name="findByStatus" content="SELECT o FROM Order o WHERE o.status = :status ORDER BY o.orderedOn DESC" returnType="java.util.List">
                    <queryParameters>
                        <queryParameter name="status" className="java.lang.String"/>
                    </queryParameters>
                </query>
            </queries>
            <indexes>
                <index name="IDX_ORDER_STATUS">
                    <fieldNames>
                        <fieldName>status</fieldName>
                    </fieldNames>
                </index>
            </indexes>
        </businessObject>
        <businessObject qualifiedName="com.example.sales.OrderLine">
            <description>Line item owned by an order.</description>
            <fields>
                <field type="STRING" length="64" name="itemCode" nullable="false" collection="false"/>
                <field type="STRING" length="255" name="description" nullable="false" collection="false"/>
                <field type="INTEGER" name="quantity" nullable="false" collection="false"/>
                <field type="DOUBLE" name="unitPrice" nullable="false" collection="false"/>
            </fields>
            <uniqueConstraints/>
            <queries/>
            <indexes/>
        </businessObject>
    </businessObjects>
</businessObjectModel>
